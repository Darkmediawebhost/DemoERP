{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://demoerp-backend.onrender.com/api/:path*" },
    { "source": "/download/:path*", "destination": "https://demoerp-backend.onrender.com/download/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
